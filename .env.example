# Copy this file to .env and replace placeholders.

# Core Django
DJANGO_SECRET_KEY=replace_with_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (default: MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=dronesec_db
DB_USER=dronesec_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=3306
# SQLITE_NAME=db.sqlite3

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=DroneSec <your-email@example.com>
CONTACT_RECEIVER_EMAIL=security@example.com

# reCAPTCHA v2
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/users/google/callback/

# Seed credentials (required before running: python manage.py seed)
SEED_ADMIN_PASSWORD=Admin@1234
SEED_AGENT_PASSWORD=Admin@1234

# AI Assistant (OpenAI-compatible)
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_BASE_URL=https://api.openai.com/v1
AI_ASSISTANT_MODEL=gpt-4o-mini
AI_ASSISTANT_TEMPERATURE=0.65
AI_ASSISTANT_TIMEOUT_SECONDS=25
AI_ASSISTANT_MAX_HISTORY=10

# Optional aliases (also supported)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama profile example
# AI_ASSISTANT_API_KEY=
# AI_ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1
# AI_ASSISTANT_MODEL=llama3.2:3b
